# ==============================================
# API SENTINEL - ENVIRONMENT CONFIGURATION
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security Engine Service (FastAPI)
SECURITY_ENGINE_URL=http://127.0.0.1:8000

# Database Configuration (MongoDB Atlas or Local)
# If left empty, API Sentinel runs in resilient in-memory development mode
MONGODB_URI=mongodb://127.0.0.1:27017/api-sentinel

# Authentication & Security
JWT_SECRET=sentinel_jwt_secret_production_key_change_in_prod_998811
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# AI Configuration (Optional: if not set, API Sentinel uses its built-in rule-based Security Reasoner & ML Engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Upload Configuration
MAX_UPLOAD_SIZE_MB=15
